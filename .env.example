# 服务
PORT=3000
NODE_ENV=development

# 数据库：sqlite（本地开发）/ postgres（测试、生产）
DB_TYPE=sqlite
DB_PATH=./data/drift-islands.sqlite
# DB_TYPE=postgres
# DATABASE_URL=postgres://drift:drift@localhost:5432/drift_islands

# Redis（可选；未配置时使用进程内内存实现，单实例可用）
# REDIS_URL=redis://localhost:6379

# 会话签名密钥（生产必须替换）
JWT_SECRET=dev-secret-change-me

# AI 网关（OpenAI 兼容接口；不配置时全部走模板叙述）
AI_BASE_URL=
AI_API_KEY=
AI_MODEL_SMALL=
AI_MODEL_LARGE=
AI_TIMEOUT_MS=20000

# 多模型池（逗号分隔，small:/large: 前缀；密钥只放在 .env，不要提交）
# OPENROUTER_API_KEYS=
# OPENROUTER_MODELS=small:openrouter/free,large:openrouter/free
# NVIDIA_API_KEYS=
# NVIDIA_MODELS=large:meta/muse-glimmer-30b
# 硅基流动：OpenAI 兼容，免费额度较宽松
# SILICONFLOW_API_KEYS=
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# SILICONFLOW_MODELS=small:Qwen/Qwen2.5-7B-Instruct,small:Qwen/Qwen3-8B,small:Qwen/Qwen2.5-14B-Instruct,large:Qwen/Qwen3-32B

# 玩法与成本参数
AI_DAILY_BUDGET=200
COMBAT_ROUND_MS=15000
WORLD_TICK_MS=5000
ENCOUNTER_RANGE_DAY_NM=12
ENCOUNTER_RANGE_NIGHT_NM=6
